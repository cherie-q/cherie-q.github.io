---
import Base from '../layouts/Base.astro';
import SayHello from '../components/SayHello.astro';
import { SITE, SERIES, SERIES_IDS } from '../data/site';
import { requireFragment, getSeriesParts, getWriting, postUrl, postScene, seriesUrl, formatDate } from '../lib/posts';

const id = SERIES_IDS[0];
const series = SERIES[id];
const parts = await getSeriesParts(id);
const first = parts[0];
if (!first) throw new Error('The featured series must have at least one published post.');
const standalonePosts = (await getWriting()).filter((post) => !post.data.series);
const writing = [
  ...standalonePosts.map((post) => ({
    id: post.id,
    title: post.data.title,
    summary: post.data.summary ?? post.data.description,
    date: post.data.date,
    label: undefined,
    href: postUrl(post),
    scene: postScene(post),
    actions: [{ label: 'Read the essay', href: postUrl(post) }],
  })),
  {
    id,
    title: series.title,
    summary: series.description,
    date: first.data.date,
    label: `${parts.length}-part series`,
    href: seriesUrl(id),
    scene: postScene(first),
    actions: [
      { label: 'Start with part 1', href: postUrl(first) },
      { label: 'Explore the series', href: seriesUrl(id) },
    ],
  },
].sort((a, b) => (b.date?.valueOf() ?? 0) - (a.date?.valueOf() ?? 0));
---
<Base title={SITE.title} description={SITE.tagline} type="website" narrow section="writing">
  <div class="intro">
    <header class="takeaway">
      <h1>{SITE.title}</h1>
      <p class="lead">{SITE.tagline}</p>
    </header>
    <Fragment set:html={requireFragment('_home-hero')} />
  </div>
  <section id="why" aria-labelledby="why-h">
    <h2 id="why-h">Hi, I’m Cherie</h2>
    <Fragment set:html={requireFragment('_why')} />
  </section>
  <section id="writing" aria-labelledby="writing-h">
    <h2 id="writing-h">Writing</h2>
    <div class="writing-grid">
      {writing.map((entry) => (
        <article class="writing-card" aria-labelledby={`writing-${entry.id}`}>
          {entry.scene && (
            <div class="writing-card-art" aria-hidden="true">
              <Fragment set:html={entry.scene} />
            </div>
          )}
          <div class="writing-card-body">
            <p class="post-meta">
              {entry.date && (
                <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
              )}
              {entry.date && entry.label && ' · '}
              {entry.label}
            </p>
            <h3 id={`writing-${entry.id}`}><a href={entry.href}>{entry.title}</a></h3>
            <p class="writing-card-summary">{entry.summary}</p>
            <p class="writing-card-actions">
              {entry.actions.map((action) => <a href={action.href}>{action.label}</a>)}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <SayHello />
</Base>
